{
  "name": "eskrestaurant",
  "version": "1.0.11",
  "description": "Local Restaurant POS System",
  "author": "mr-samikhan",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "electron:build:mac": "npm run build && electron-builder --mac zip",
    "electron:build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "release": "npm version patch && git push origin main --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-samikhan/esk-restaurant.git"
  },
  "build": {
    "appId": "com.mr-samikhan.eskrestaurant",
    "productName": "ESK",
    "publish": [
      {
        "provider": "github",
        "owner": "mr-samikhan",
        "repo": "esk-restaurant"
      }
    ],
    "files": [
      "dist/**/*",
      "main.mjs",
      "electron/**/*",
      "package.json",
      "firebase-config.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
